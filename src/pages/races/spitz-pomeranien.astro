        <tr><td>Suivi vétérinaire annuel (vaccins, antiparasitaires)</td><td>200 – 380 €</td></tr>
        <tr><td>Toilettage professionnel (robe double, 4-6 fois/an)</td><td>200 – 400 €</td></tr>
        <tr><td>Bilan dentaire annuel (détartrage, petite race)</td><td>100 – 250 €</td></tr>
        <tr><td>Assurance santé (formule intermédiaire)</td><td>180 – 320 €</td></tr>
        <tr><td>Imprévus vétérinaires (hors assurance)</td><td>150 – 500 €</td></tr>
        <tr class="is-total"><td><strong>Total estimé</strong></td><td><strong>1 130 – 2 350 €/an</strong></td></tr>
