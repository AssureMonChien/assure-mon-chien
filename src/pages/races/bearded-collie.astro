        <tr><th>Poste de dépense</th><th>Coût estimé / an</th></tr>
      </thead>
      <tbody>
        <tr><td>Alimentation (taille moyenne, croquettes premium)</td><td>500 – 800 €</td></tr>
        <tr><td>Suivi vétérinaire annuel (vaccins, antiparasitaires)</td><td>200 – 380 €</td></tr>
        <tr><td>Toilettage professionnel (robe longue, 4-6 fois/an)</td><td>300 – 600 €</td></tr>
        <tr><td>Assurance santé (formule intermédiaire)</td><td>160 – 260 €</td></tr>
        <tr><td>Imprévus vétérinaires (hors assurance)</td><td>150 – 400 €</td></tr>
        <tr class="is-total"><td><strong>Total estimé</strong></td><td><strong>1 310 – 2 440 €/an</strong></td></tr>
