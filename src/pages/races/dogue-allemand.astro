        <tr><td>Suivi vétérinaire annuel (vaccins, bilans, antiparasitaires)</td><td>300 – 550 €</td></tr>
        <tr><td>Toilettage et entretien (robe courte, entretien oreilles)</td><td>80 – 180 €</td></tr>
        <tr><td>Accessoires grande taille (couchage, laisses, harnais)</td><td>150 – 300 €</td></tr>
        <tr><td>Assurance santé (formule intermédiaire)</td><td>360 – 600 €</td></tr>
        <tr><td>Imprévus vétérinaires (hors assurance)</td><td>500 – 1 500 €</td></tr>
        <tr class="is-total"><td><strong>Total estimé</strong></td><td><strong>2 290 – 4 530 €/an</strong></td></tr>
