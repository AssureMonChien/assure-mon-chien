        <tr><td>Suivi vétérinaire annuel (vaccins, antiparasitaires)</td><td>200 – 380 €</td></tr>
        <tr><td>Toilettage professionnel (robe double épaisse, 4-6 fois/an)</td><td>200 – 400 €</td></tr>
        <tr><td>Assurance santé (formule intermédiaire)</td><td>160 – 280 €</td></tr>
