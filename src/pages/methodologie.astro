---
import Layout from "../layouts/Layout.astro";

const siteUrl   = "https://assure-mon-chien.fr";
const pageUrl   = `${siteUrl}/methodologie`;
const ogImgUrl  = `${siteUrl}/images/methodologie/auteur-sheltie.webp`;

const jsonldArticle = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
  "headline": "Notre méthodologie : sources, calculateur et transparence",
  "description": "Comment nous travaillons : sources publiques (FACCO, ESCCAP, clubs SCC), méthode du calculateur coût chien, sélection des 3 assureurs comparés, transparence sur l'affiliation. Vos retours bienvenus.",
  "image": ogImgUrl,
  "url": pageUrl,
  "datePublished": "2026-05-31",
  "dateModified": "2026-05-31",
  "author":    { "@type": "Organization", "name": "Assure Mon Chien", "url": siteUrl },
  "publisher": { "@type": "Organization", "name": "Assure Mon Chien", "url": siteUrl,
    "logo": { "@type": "ImageObject", "url": `${siteUrl}/favicon.svg` } }
});

const jsonldBreadcrumb = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil",      "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Méthodologie", "item": pageUrl }
  ]
});
---

<Layout
  title="Notre méthodologie : sources, calculateur et transparence — Assure Mon Chien"
  description="Comment nous travaillons : sources publiques (FACCO, ESCCAP, clubs SCC), méthode du calculateur coût chien, sélection des 3 assureurs comparés, transparence sur l'affiliation. Vos retours bienvenus."
  ogImage={ogImgUrl}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonldArticle} />
    <script type="application/ld+json" set:html={jsonldBreadcrumb} />
  </Fragment>

  <!-- ── Hero 2 colonnes : texte + photo ── -->
  <header class="ed-hero">
    <div class="container ed-hero-inner">

      <div class="ed-hero-text">
        <nav class="ed-breadcrumb" aria-label="Fil d'Ariane">
          <ol>
            <li><a href="/">Accueil</a></li>
            <li aria-current="page">Méthodologie</li>
          </ol>
        </nav>
        <span class="ed-eyebrow">Transparence éditoriale</span>
        <h1 class="ed-title">Notre méthodologie</h1>
        <p class="ed-lede">Notre objectif est simple : aider les propriétaires de chiens à prendre des décisions financières éclairées sur la santé de leur animal, sans biais commercial ni jargon inutile. Cette page expose comment nous travaillons — les sources que nous utilisons, comment le calculateur est construit, pourquoi nous avons sélectionné trois assureurs plutôt que dix, et comment nous nous finançons. Nous publions cette méthodologie parce que vous avez le droit de savoir avant de cliquer.</p>
        <div class="ed-meta">
          <span class="ed-meta-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="15" rx="2"/><path d="M3.5 10.5h17M8 3v4M16 3v4"/></svg>
            Mai 2026
          </span>
          <span class="ed-meta-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            5 min de lecture
          </span>
        </div>
      </div>

      <figure class="ed-hero-figure">
        <div class="ed-hero-img-wrap">
          <img
            src="/images/methodologie/auteur-sheltie.webp"
            alt="Berger des Shetlands de l'auteur du site"
            width="640"
            height="427"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            class="ed-hero-img"
          />
        </div>
        <figcaption>Notre Berger des Shetlands, à l'origine de ce site.</figcaption>
      </figure>

    </div>
  </header>

  <!-- ── Corps : TOC + Article ── -->
  <div class="container ed-body">

    <aside class="ed-toc" aria-label="Sommaire">
      <div class="ed-toc-label">Sommaire</div>
      <ol>
        <li><a href="#demarche">Notre démarche</a></li>
        <li><a href="#sources">Sources et données</a></li>
        <li><a href="#calculateur">Méthode du calculateur</a></li>
        <li><a href="#assureurs">Sélection des assureurs</a></li>
        <li><a href="#transparence">Transparence financière</a></li>
        <li><a href="#mises-a-jour">Mises à jour</a></li>
        <li><a href="#corrections">Erreurs et corrections</a></li>
      </ol>
    </aside>

    <article class="ed-article">

      <!-- ── 1. Notre démarche ── -->
      <h2 class="ed-h2" id="demarche">Notre démarche</h2>

      <p class="ed-p">À l'origine de ce site, une histoire personnelle. J'ai grandi avec des chats, et j'avais toujours considéré le chien comme une contrainte plus qu'un compagnon. Ma compagne en rêvait depuis longtemps. Après plusieurs mois de réflexion, nous avons sauté le pas — nous partageons aujourd'hui notre quotidien avec un Berger des Shetlands.</p>

      <p class="ed-p">Une fois la décision prise, les questions ont commencé : quelles maladies sont fréquentes chez cette race ? Quels coûts anticiper sur 10 ou 15 ans ? Faut-il une assurance, et laquelle ? Les réponses se trouvaient, mais dispersées entre forums, sites d'assureurs, blogs et clubs de race. Aucun endroit ne rassemblait l'information de manière structurée et neutre. Il m'a fallu plusieurs semaines pour reconstituer le tableau complet.</p>

      <p class="ed-p">Ce site est né de ce constat. L'idée : centraliser ce que j'ai mis du temps à trouver, pour que les futurs propriétaires gagnent quelques semaines sur leur propre recherche. Et pour les propriétaires actuels, mettre à disposition des chiffres et des outils qu'ils peuvent confronter à leur expérience.</p>

      <p class="ed-p">Au-delà de l'histoire personnelle, l'objectif éditorial reste classique : une fiche par race avec ses prédispositions sanitaires documentées, un <a href="/outils/calculateur-cout-chien">calculateur qui projette le coût réel sur 12 ans</a>, et une <a href="/comparatif/meilleures-assurances">sélection restreinte de trois assureurs comparés sur des critères explicites</a>. Tout ce que nous publions est soit sourcé, soit clairement présenté comme une opinion.</p>

      <p class="ed-p">Nous ne sommes pas un cabinet vétérinaire. Nous ne donnons pas de conseils médicaux personnalisés. Nous analysons des données publiques et des publications professionnelles pour aider à anticiper un budget et choisir une couverture adaptée à un profil race + région + mode de vie.</p>

      <!-- ── 2. Sources et données ── -->
      <h2 class="ed-h2" id="sources">Sources et données</h2>

      <p class="ed-p">Chaque chiffre publié sur ce site s'appuie sur une source vérifiable. Les principales :</p>

      <dl class="meth-sources">
        <div class="meth-source-item">
          <dt>Données démographiques et alimentation.</dt>
          <dd>La FACCO (Fédération des fabricants d'aliments pour chiens, chats et autres animaux familiers) publie une enquête nationale annuelle sur la démographie canine et féline en France. Ses données 2024-2025 alimentent nos estimations alimentaires et la répartition des races.</dd>
        </div>
        <div class="meth-source-item">
          <dt>Prédispositions santé par race.</dt>
          <dd>Pour chacune de nos 41 fiches races, nous croisons trois sources : le club de race officiel affilié à la Société Centrale Canine, les recommandations de l'ESCCAP France (European Scientific Counsel Companion Animal Parasites) sur les pathologies par groupe de races, et les statistiques de l'OFA (Orthopedic Foundation for Animals) sur les affections orthopédiques par race. Quand un club ou une étude documente une fréquence chiffrée, nous la citons explicitement avec l'année.</dd>
        </div>
        <div class="meth-source-item">
          <dt>Études peer-reviewed.</dt>
          <dd>Pour les pathologies les mieux documentées dans la littérature vétérinaire, nous citons les études fondatrices : Glickman et al. (JAVMA 1994) pour les risques de dilatation-torsion gastrique chez les races géantes, Meurs et al. (JVIM 1999) pour la cardiomyopathie dilatée du Dogue Allemand, Coates et Wininger (Vet Clin North Am 2010) pour la myélopathie dégénérative. Ces références sont consultables sur PubMed ou Google Scholar.</dd>
        </div>
        <div class="meth-source-item">
          <dt>Tarifs vétérinaires.</dt>
          <dd>Les fourchettes de coût des actes viennent du barème SNVEL (Syndicat National des Vétérinaires d'Exercice Libéral), des grilles publiques des écoles vétérinaires (CHVA, VetAgro Sup Lyon, EnvA Maisons-Alfort) et des données 2024-2025 de plateformes spécialisées.</dd>
        </div>
        <div class="meth-source-item">
          <dt>Tarifs d'assurance.</dt>
          <dd>Notre comparatif s'appuie sur le baromètre 2026 de LeComparateurAssurance pour les fourchettes de marché, et sur les grilles tarifaires publiques 2025-2026 des trois assureurs sélectionnés.</dd>
        </div>
        <div class="meth-source-item">
          <dt>Adoption.</dt>
          <dd>Les tarifs viennent des barèmes officiels de la Société Protectrice des Animaux.</dd>
        </div>
      </dl>

      <p class="ed-p">Si vous repérez une donnée qui vous semble erronée, signalez-la nous (section <a href="#corrections">Erreurs et corrections</a> en bas de page).</p>

      <!-- ── 3. Méthode du calculateur ── -->
      <h2 class="ed-h2" id="calculateur">Méthode du calculateur</h2>

      <p class="ed-p">Le <a href="/outils/calculateur-cout-chien">calculateur de coût d'un chien sur 12 ans</a> intègre six variables, chacune avec un impact chiffrable :</p>

      <ul class="meth-ul">
        <li><strong>Taille adulte</strong> (petite &lt; 10 kg, moyenne 10-27 kg, grande &gt; 27 kg) : multiplicateur principal, de ×1 à ×3 sur le coût total.</li>
        <li><strong>Race :</strong> un coefficient vétérinaire de +5 à +40 % s'applique sur la part véto selon les prédispositions sanitaires documentées. Les races classées à risque élevé déclenchent en plus un surcoût de cotisation assurance de +30 %, conforme aux tarifs marché.</li>
        <li><strong>Région :</strong> coefficient régional de 0,95× (zone rurale) à 1,20× (Île-de-France) sur les actes vétérinaires.</li>
        <li><strong>Formule d'alimentation :</strong> standard, premium ou sur-mesure (×1, ×1,4 ou ×1,7).</li>
        <li><strong>Formule d'assurance :</strong> Sans (0 €/an), Éco (~250 €/an, ~30 % de remboursement), Complète (~480 €/an, ~85 %). Le delta Sans/Complète est le chiffre clé pour décider.</li>
        <li><strong>Hypothèse d'incidents chirurgicaux :</strong> 0 à 6 sur la vie du chien, avec un défaut suggéré selon le profil race.</li>
      </ul>

      <p class="ed-p">L'estimation suit une courbe bimodale : pic année 1 (acquisition + setup), palier croisière (années 2-10), remontée sénior (années 11-12 avec frais véto × 1,6 à × 2). C'est pourquoi multiplier un coût annuel moyen par 12 sous-estime systématiquement le coût réel d'un chien.</p>

      <p class="ed-p">L'estimation reste indicative. Trois sources d'écart peuvent la déplacer de ±20 % : le vétérinaire choisi (tarifs non réglementés en France, écarts importants en zone urbaine), le mode de garde (pension, dog-walker, famille proche), et la variance imprévisible des incidents de santé.</p>

      <!-- ── 4. Sélection des assureurs ── -->
      <h2 class="ed-h2" id="assureurs">Sélection des assureurs</h2>

      <p class="ed-p">Nous comparons trois assureurs : SantéVet, Assur O'Poil et Lassie. Trois plutôt que dix, parce qu'un comparateur sérieux doit savoir trancher.</p>

      <p class="ed-p"><strong>Critères d'inclusion :</strong></p>
      <ul class="meth-ul">
        <li>Couverture nationale en France</li>
        <li>Au moins trois formules pour permettre une comparaison utile</li>
        <li>Tarification publiquement accessible (sans formulaire détaillé préalable)</li>
        <li>Présence sur le marché français depuis au moins trois ans</li>
        <li>Programme d'affiliation actif (déclaré en section Transparence financière)</li>
      </ul>

      <p class="ed-p">Pourquoi pas les autres ? Les offres réservées à des banques ou réseaux fermés ne sont pas accessibles à tous nos lecteurs. Les assureurs sans tarification publique préalable ne permettent pas une comparaison méthodique. Les acteurs trop récents (moins de 3 ans) manquent de recul sur la qualité de gestion sinistre.</p>

      <div class="ed-callout ed-callout-green">
        <div class="ed-callout-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
        </div>
        <div>
          <div class="ed-callout-title">Notre engagement de neutralité</div>
          <p>Le calculateur peut afficher « Sans assurance » comme scénario le moins coûteux pour certains profils — petit chien robuste en zone rurale, propriétaire avec capacité d'épargne démontrée, 0 incident chirurgical sur 12 ans. C'est volontaire. Si notre intérêt commercial dictait notre éditorial, ce résultat n'apparaîtrait pas.</p>
        </div>
      </div>

      <!-- ── 5. Transparence financière ── -->
      <h2 class="ed-h2" id="transparence">Transparence financière</h2>

      <p class="ed-p">Ce site est financé par des commissions d'affiliation versées par les assureurs sélectionnés quand un utilisateur souscrit après être passé par nos liens. Trois programmes sont actifs :</p>

      <ul class="meth-ul">
        <li>SantéVet via la plateforme Affilae</li>
        <li>Assur O'Poil via la plateforme Affilae</li>
        <li>Lassie via la plateforme Addrevenue</li>
      </ul>

      <p class="ed-p">Vous payez le même prix que si vous étiez allé directement chez l'assureur. La commission est versée par l'assureur, pas par vous. Aucun assureur ne nous paie pour figurer dans notre sélection — le critère est l'inclusion par mérite éditorial, pas le tarif d'affiliation.</p>

      <p class="ed-p">Ce modèle a un biais structurel à reconnaître : nous avons un intérêt financier à ce que vous souscriviez. Pour limiter ce biais, le calculateur intègre explicitement le scénario « Sans assurance » et l'analyse honnêtement quand il est meilleur. Notre meilleur garde-fou est votre capacité à vérifier nos chiffres et à nous reprendre quand nous nous trompons.</p>

      <!-- ── 6. Mises à jour ── -->
      <h2 class="ed-h2" id="mises-a-jour">Mises à jour</h2>

      <p class="ed-p">Le secteur de l'assurance santé canine évolue lentement, mais les barèmes vétérinaires et les données sanitaires des clubs sont révisés annuellement. Nos engagements :</p>

      <ul class="meth-ul">
        <li><strong>Tarifs assureurs :</strong> révision deux fois par an (janvier et juillet), avec le millésime affiché sur chaque comparatif.</li>
        <li><strong>Coefficients race :</strong> révision annuelle, ou à chaque publication majeure d'un club ou d'une étude peer-reviewed.</li>
        <li><strong>Données générales</strong> (FACCO, ESCCAP, OFA) : intégration dans le mois suivant leur publication officielle.</li>
      </ul>

      <p class="ed-p">Chaque fiche race et chaque guide affichent leur date de dernière mise à jour (champ <code>dateModified</code> dans le code source). Si vous lisez une page avec une date de plus de 12 mois, certains chiffres peuvent avoir évolué — vérifiez avec votre vétérinaire ou votre assureur avant toute décision importante.</p>

      <!-- ── 7. Erreurs et corrections ── -->
      <h2 class="ed-h2" id="corrections">Erreurs et corrections</h2>

      <p class="ed-p">Nous ne sommes pas infaillibles. Si vous repérez une donnée que vous savez fausse, un coefficient race qui ne colle pas à votre expérience d'éleveur ou de vétérinaire, une source mal interprétée, ou simplement une information obsolète — dites-le nous.</p>

      <p class="ed-p"><strong>Pour signaler :</strong> écrivez à <a href="mailto:assuremonchien@gmail.com">assuremonchien@gmail.com</a>. Précisez la page concernée (URL), la donnée contestée, et si possible une source alternative.</p>

      <p class="ed-p"><strong>Nos engagements :</strong></p>
      <ul class="meth-ul">
        <li>Accusé de réception sous 48 heures</li>
        <li>Vérification et réponse argumentée sous 7 jours</li>
        <li>Correction publique si l'erreur est avérée, avec mention dans le journal de modifications de la page</li>
      </ul>

      <p class="ed-p">Les retours les plus précieux nous viennent des éleveurs, des clubs de race officiels et des vétérinaires en exercice. Vos corrections rendent ce site meilleur pour les lecteurs suivants.</p>

    </article>
  </div>
</Layout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const tocLinks = Array.from(document.querySelectorAll(".ed-toc a[href^='#']"));
    if (!tocLinks.length) return;
    const items = tocLinks
      .map((a) => {
        const id = a.getAttribute("href").slice(1);
        const target = id ? document.getElementById(id) : null;
        const li = a.closest("li");
        return target && li ? { id, target, li } : null;
      })
      .filter(Boolean);
    if (!items.length) return;
    const TRIGGER_Y = 140;
    let last = null;
    const update = () => {
      let current = items[0];
      for (const it of items) {
        if (it.target.getBoundingClientRect().top <= TRIGGER_Y) current = it;
        else break;
      }
      if (current === last) return;
      items.forEach((it) => it.li.classList.toggle("is-active", it === current));
      last = current;
    };
    update();
    let scheduled = false;
    window.addEventListener("scroll", () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => { update(); scheduled = false; });
    }, { passive: true });
  });
</script>

<style>
  /* Image cadrée légèrement en haut pour bien voir la tête du chien */
  .ed-hero .ed-hero-img { object-position: center 30%; }

  /* ── ul lists in article ── */
  .meth-ul {
    margin: 0 0 22px;
    padding-left: 1.5rem;
  }
  .meth-ul li {
    font-size: 16px;
    color: var(--c-ink-2);
    margin-bottom: 6px;
    line-height: 1.65;
  }

  /* ── Definition list — sources ── */
  .meth-sources { margin: 4px 0 22px; }
  .meth-source-item {
    margin-bottom: 14px;
    padding: 10px 14px;
    border-left: 2px solid var(--c-green-200);
    background: var(--c-green-50);
    border-radius: 0 6px 6px 0;
  }
  .meth-source-item:last-child { margin-bottom: 0; }
  .meth-source-item dt {
    font-weight: 700;
    color: var(--c-green-700);
    margin-bottom: 4px;
    font-size: 15px;
  }
  .meth-source-item dd {
    margin: 0;
    color: var(--c-ink-2);
    font-size: 14px;
    line-height: 1.65;
  }

  /* ── Inline code ── */
  .ed-article code {
    font-size: 0.875em;
    background: var(--c-green-50);
    color: var(--c-green-700);
    padding: 2px 6px;
    border-radius: 3px;
    font-family: ui-monospace, "Cascadia Code", "Fira Mono", monospace;
  }


</style>
