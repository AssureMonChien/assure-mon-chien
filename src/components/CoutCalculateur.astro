<script is:inline define:vars={{ RACES_DATA: racesData }}>
/* ───────────────────────────────────────────────────────────────
   Calculateur — coefficients V1 (validés par sources, 17 mai 2026)
   Sources : FACCO 2025, Réassurez-moi 2026, Meilleurtaux 2026,
   LeComparateurAssurance baromètre janv. 2026, SPA, cliniques véto.
   ─────────────────────────────────────────────────────────────── */

/* RACES_DATA est injecté via define:vars depuis Astro */
const RACES = (typeof RACES_DATA !== 'undefined') ? RACES_DATA : [];

/* Coefficients V1 — voir Assur toutou/CALCULATEUR-COEFFICIENTS-V1.md */
const COSTS = {
  taille: { petit: 850, moyen: 1150, grand: 1700, geant: 2400 },
  alim: { standard: 1.00, premium: 1.40, "sur-mesure": 1.70 },
  region: {
    moy: 1.00, idf: 1.20, paca: 1.15, ara: 1.05, corse: 1.10,
    occitanie: 1.00, "nouvelle-aquitaine": 1.00, ge: 1.00,
    pdl: 0.98, normandie: 0.98,
    hdf: 0.95, bretagne: 0.95, cvl: 0.95, bfc: 0.95,
  },
  equip: { essentiel: 1.00, confort: 1.12, premium: 1.25 },
  /* Cotisations 2026 (médian marché) + rebates ré-haussés pour refléter
     les vrais remboursements (incidents lourds couverts à 80-90%) */
  assur: {
    aucune:   { cost: 0,   rebate: 0.00 },
    eco:      { cost: 250, rebate: 0.30 },
    complete: { cost: 480, rebate: 0.85 },
  },
};
const RACE_COEF = { faible: 1.05, modere: 1.20, eleve: 1.40 };
/* Provision "incidents majeurs" amortie sur 12 ans — c'est ce que l'assurance protège.
   Probabilité × montant moyen d'un incident chirurgical/maladie chronique sur la vie du chien.
   Calibré pour que l'assurance Complète soit GAGNANTE sur 12 ans pour les races à risque eleve
   (Labrador, Bouledogue, Cavalier KC, etc.) et marginalement perdante pour les races saines. */
const INCIDENT_AMOUNT_BY_SIZE = { petit: 1800, moyen: 2400, grand: 3000, geant: 3800 };
/* Nombre d'incidents chirurgicaux par défaut sur 12 ans, selon profil race. */
const INCIDENT_DEFAULT_BY_RISK = { faible: 0, modere: 1, eleve: 2 };
const INCIDENT_MIN = 0;
const INCIDENT_MAX = 6;
let incidentCount = 2; /* État ajustable ; réinitialisé au défaut race à chaque sélection *//* Cotisation modulée par taille : un Yorkshire ne coûte pas le même prix qu'un Saint-Bernard à assurer */
const INSURANCE_SIZE_MULT = { petit: 0.75, moyen: 1.00, grand: 1.20, geant: 1.45 };
const ACQUISITION = { refuge: 300, eleveur: 1200, don: 100 };
const SETUP_STANDARD = 770;
const SETUP_REFUGE = 250;
const TAILLE_FROM_RACE = { petite: 'petit', moyenne: 'moyen', grande: 'grand' };

/* Format euro */
const fmt = new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 });
function eur(n) { return fmt.format(Math.round(n)) + ' €'; }

/* Animation count-up */
function animateNum(el, to, suffix) {
  suffix = suffix || '';
  const from = parseInt((el.dataset.cur || '0').replace(/[^\d-]/g, ''), 10) || 0;
  const dur = 550;
  const t0 = performance.now();
  function step(t) {
    const p = Math.min(1, (t - t0) / dur);
    const eased = 1 - Math.pow(1 - p, 3);
    const v = Math.round(from + (to - from) * eased);
    el.textContent = fmt.format(v) + suffix;
    if (p < 1) requestAnimationFrame(step);
    else el.dataset.cur = String(to);
  }
  requestAnimationFrame(step);
}

/* ───── Helpers DOM ───── */
function val(name) {
  const f = document.querySelector('input[name="' + name + '"]:checked');
  return f ? f.value : null;
}

/* Champs requis : taille, region, alim, assur (équipement et provenance ont des défauts) */
const REQUIRED = ['race', 'region', 'alim', 'assur'];
const REQ_TOTAL = REQUIRED.length;

function fieldsCompleted() {
  let n = 0;
  const raceVal = document.getElementById('race').value;
  if (raceVal) {
    if (raceVal === 'autre') {
      /* race "autre" choisi → la taille manuelle est requise pour compter */
      if (val('taille')) n++;
    } else {
      /* race réelle → taille auto-déduite, on compte race comme rempli */
      n++;
    }
  }
  if (document.getElementById('region').value) n++;
  if (val('alim')) n++;
  if (val('assur')) n++;
  return n;
}
function isReady() { return fieldsCompleted() === REQ_TOTAL; }

function syncActiveClasses() {
  document.querySelectorAll('.calc-option').forEach(function(label) {
    const input = label.querySelector('input[type="radio"]');
    if (input && input.checked) label.classList.add('is-active');
    else label.classList.remove('is-active');
  });
}

/* ───── Compute principal ───── */
function compute() {
  if (!isReady()) {
    renderEmpty();
    return null;
  }
  const t = val('taille');
  const a = val('alim');
  const r = document.getElementById('region').value || 'moy';
  const ins = val('assur');
  const eq = val('equip') || 'confort';
  const prov = val('provenance') || 'eleveur';
  const raceSlug = document.getElementById('race').value || '';

  /* Race lookup */
  const race = RACES.find(function(rc) { return rc.slug === raceSlug; });
  const raceCoef = race ? RACE_COEF[race.risque] : 1.00;
  const raceSensitive = race && race.risque === 'eleve';

  /* Base annuelle (avant assurance, hors acquisition) */
  const base = COSTS.taille[t] * COSTS.region[r] * COSTS.equip[eq];
  const partFood = base * 0.45 * COSTS.alim[a];
  const partVet  = base * 0.22 * raceCoef;
  const partGear = base * 0.13;
  const partCare = base * 0.08;

  /* Provision incidents majeurs amortie sur 12 ans (nb incidents × coût moyen / 12) */
  const incidentAmount = INCIDENT_AMOUNT_BY_SIZE[t];
  const incidentExpectedAnnual = (incidentAmount * incidentCount) / 12;

  /* Année 1 : acquisition + setup, identiques quelle que soit la formule */
  const setupCost = (prov === 'refuge') ? SETUP_REFUGE : SETUP_STANDARD;
  const acqCost   = ACQUISITION[prov];

  /* Construit un scénario complet (total 12 ans + breakdown) pour une formule donnée.
     "aucune" → cost=0, rebate=0 → équivalent à l'ancien totalNoIns. */
  function scenarioFor(insLevel) {
    const insCost = COSTS.assur[insLevel].cost * INSURANCE_SIZE_MULT[t] * (raceSensitive ? 1.15 : 1.00);
    const insRebate = COSTS.assur[insLevel].rebate;
    const vetGrossAnnual = partVet + incidentExpectedAnnual;
    const vetNetAnnual = vetGrossAnnual * (1 - insRebate);
    const annualNormal = partFood + vetNetAnnual + partGear + partCare + insCost;
    const year1 = annualNormal + setupCost + acqCost;
    /* Sénior années 11-12 : véto courant + incidents × 2.0 (gériatrie) */
    const vetSeniorNet = vetGrossAnnual * 2.00 * (1 - insRebate);
    const seniorAnnual = (partFood * 0.95) + vetSeniorNet + (partGear * 0.70) + (partCare * 1.10) + insCost;
    const total = year1 + (annualNormal * 9) + (seniorAnnual * 2);
    return {
      total: total,
      year1: year1,
      annualNormal: annualNormal,
      seniorAnnual: seniorAnnual,
      parts: { food: partFood * 12, vet: vetNetAnnual * 12, ins: insCost * 12, gear: partGear * 12, care: partCare * 12 },
    };
  }

  const scenarios = {
    aucune:   scenarioFor('aucune'),
    eco:      scenarioFor('eco'),
    complete: scenarioFor('complete'),
  };
  const chosen = scenarios[ins];

  return {
    total: chosen.total,
    year1: chosen.year1,
    annualNormal: chosen.annualNormal,
    seniorAnnual: chosen.seniorAnnual,
    parts: chosen.parts,
    scenarios: scenarios,
    totalNoIns: scenarios.aucune.total,
    raceName: race ? race.nom : null,
    raceSensitive: raceSensitive,
    insChosen: ins,
    taille: t,
  };
}

/* ───── Render résultats ───── */
function renderEmpty() {
  document.getElementById('results-caption').textContent = 'Complétez le formulaire pour voir votre estimation.';
  ['scn-aucune-amt','scn-eco-amt','scn-complete-amt','rs-y1','rs-avg','rs-senior'].forEach(function(id) {
    const el = document.getElementById(id); if (el) { el.textContent = '—'; el.dataset.cur = '0'; }
  });
  document.querySelectorAll('.scn-card').forEach(function(c) { c.classList.remove('is-selected'); });
  document.getElementById('br-sub').textContent = '— —';
  document.getElementById('results-live-pill').setAttribute('hidden', '');
  document.getElementById('results-card').classList.remove('is-filled');
  ['pct-food','pct-vet','pct-insure','pct-gear','pct-care'].forEach(function(id) {
    const el = document.getElementById(id); if (el) el.textContent = '—';
  });
  ['amt-food','amt-vet','amt-insure','amt-gear','amt-care'].forEach(function(id) {
    const el = document.getElementById(id); if (el) el.textContent = '—';
  });
}

function renderResults(R) {
  /* 3 scenario cards (Sans / Éco / Complète) — animation count-up sur chacune */
  animateNum(document.getElementById('scn-aucune-amt'), R.scenarios.aucune.total);
  animateNum(document.getElementById('scn-eco-amt'), R.scenarios.eco.total);
  animateNum(document.getElementById('scn-complete-amt'), R.scenarios.complete.total);

  /* Marque la card de la formule choisie (.is-selected) */
  ['aucune','eco','complete'].forEach(function(k) {
    const c = document.getElementById('scn-' + k + '-card');
    if (c) c.classList.toggle('is-selected', k === R.insChosen);
  });

  /* Sub-numbers (calculés sur la formule choisie) */
  document.getElementById('rs-y1').textContent = eur(R.year1);
  document.getElementById('rs-avg').textContent = eur(R.annualNormal);
  document.getElementById('rs-senior').textContent = eur(R.seniorAnnual);

  /* Caption avec formule + race en contexte */
  const insCaptionLabels = { aucune: 'Sans assurance', eco: 'Avec Éco', complete: 'Avec Complète' };
  let caption = (insCaptionLabels[R.insChosen] || '') + ' · ' + eur(R.total / 12) + ' / an en moyenne sur 12 ans';
  if (R.raceName) caption = R.raceName + ' · ' + caption;
  document.getElementById('results-caption').textContent = caption;
  document.getElementById('results-live-pill').removeAttribute('hidden');
  document.getElementById('results-card').classList.add('is-filled');

  /* Breakdown */
  const parts = R.parts;
  const sumAnnual = parts.food + parts.vet + parts.ins + parts.gear + parts.care;
  function pct(p) { return Math.round((p / sumAnnual) * 100) + '%'; }
  document.getElementById('pct-food').textContent  = pct(parts.food);
  document.getElementById('pct-vet').textContent   = pct(parts.vet);
  document.getElementById('pct-insure').textContent= pct(parts.ins);
  document.getElementById('pct-gear').textContent  = pct(parts.gear);
  document.getElementById('pct-care').textContent  = pct(parts.care);

  /* Montants totaux sur 12 ans (parts.X sont déjà multipliés par 12 dans compute()) */
  document.getElementById('amt-food').textContent  = eur(parts.food);
  document.getElementById('amt-vet').textContent   = eur(parts.vet);
  document.getElementById('amt-insure').textContent= eur(parts.ins);
  document.getElementById('amt-gear').textContent  = eur(parts.gear);
  document.getElementById('amt-care').textContent  = eur(parts.care);

  /* Stacked bar segments */
  const segs = document.querySelectorAll('.br-bar-seg');
  const totalSeg = sumAnnual;
  if (segs.length >= 5) {
    segs[0].style.flex = Math.max(1, Math.round(parts.food / totalSeg * 100));
    segs[1].style.flex = Math.max(1, Math.round(parts.vet  / totalSeg * 100));
    segs[2].style.flex = Math.max(1, Math.round(parts.ins  / totalSeg * 100));
    segs[3].style.flex = Math.max(1, Math.round(parts.gear / totalSeg * 100));
    segs[4].style.flex = Math.max(1, Math.round(parts.care / totalSeg * 100));
  }

  /* Sub-line */
  const tName = val('taille');
  const tLabel = tName ? (tName.charAt(0).toUpperCase() + tName.slice(1)) : '';
  const regionLabel = document.getElementById('region').options[document.getElementById('region').selectedIndex].textContent.trim();
  document.getElementById('br-sub').textContent = tLabel + ' · ' + regionLabel;
}

function initScenarioCards() {
  document.querySelectorAll('.scn-card').forEach(function(card) {
    card.addEventListener('click', function() {
      const scn = card.getAttribute('data-scn');
      if (!scn) return;
      const radio = document.querySelector('input[name="assur"][value="' + scn + '"]');
      if (radio && !radio.checked) {
        radio.checked = true;
        radio.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
  });
}

/* ───── Recompute debounced ───── */
let debounceTimer = null;
function scheduleCompute() {
  updateProgress();
  if (debounceTimer) clearTimeout(debounceTimer);
  debounceTimer = setTimeout(function() {
    const R = compute();
    if (R) renderResults(R);
  }, 250);
}

function updateProgress() {
  const n = fieldsCompleted();
  document.getElementById('progress-label').textContent = n + '/' + REQ_TOTAL + ' champs requis';
  const pct = Math.round((n / REQ_TOTAL) * 100);
  document.getElementById('progress-fill').style.width = pct + '%';
}

/* ───── Helpers pour la question Taille conditionnelle ───── */
function showTailleFieldset() {
  const fs = document.getElementById('field-taille');
  if (fs) fs.hidden = false;
}
function hideTailleFieldset() {
  const fs = document.getElementById('field-taille');
  if (fs) {
    fs.hidden = true;
    /* Décocher la taille si elle est cachée pour ne pas qu'elle reste sélectionnée fantôme */
  }
}

/* ───── Combobox race ───── */
/* ───── Reset incidentCount au défaut race ───── */
/* ───── Affichage de l'adjusteur d'incidents ───── */
function updateIncidentDisplay() {
  const valEl = document.getElementById('incident-count');
  const unitEl = document.getElementById('incident-unit');
  if (valEl) valEl.textContent = String(incidentCount);
  if (unitEl) unitEl.textContent = incidentCount === 1 ? 'incident' : 'incidents';
  const minus = document.getElementById('incident-minus');
  const plus = document.getElementById('incident-plus');
  if (minus) minus.disabled = (incidentCount <= INCIDENT_MIN);
  if (plus) plus.disabled = (incidentCount >= INCIDENT_MAX);
}

function initIncidentAdjuster() {
  const minusBtn = document.getElementById('incident-minus');
  const plusBtn = document.getElementById('incident-plus');
  if (!minusBtn || !plusBtn) return;
  minusBtn.addEventListener('click', function() {
    if (incidentCount > INCIDENT_MIN) {
      incidentCount--;
      updateIncidentDisplay();
      scheduleCompute();
    }
  });
  plusBtn.addEventListener('click', function() {
    if (incidentCount < INCIDENT_MAX) {
      incidentCount++;
      updateIncidentDisplay();
      scheduleCompute();
    }
  });
  updateIncidentDisplay();
}

function resetIncidentToDefault(race) {
  const defaultValue = race ? INCIDENT_DEFAULT_BY_RISK[race.risque] : 1;
  incidentCount = defaultValue;
  /* Note : les éléments DOM incident-default-value / incident-race-label seront ajoutés au Lot 3.
     Le guard if(el) évite l'erreur quand ils n'existent pas encore. */
  const defaultEl = document.getElementById('incident-default-value');
  const raceEl = document.getElementById('incident-race-label');
  if (defaultEl) defaultEl.textContent = String(defaultValue);
  if (raceEl) raceEl.textContent = race ? race.nom : 'votre chien';
  updateIncidentDisplay();
}

function initRaceCombo() {
  const combo = document.getElementById('race-combo');
  const input = document.getElementById('race-input');
  const hidden = document.getElementById('race');
  const list = document.getElementById('race-listbox');
  const clear = document.getElementById('race-clear');
  let activeIdx = -1;

  function renderList(filter) {
    filter = (filter || '').toLowerCase().trim();
    const matches = RACES.filter(function(r) { return !filter || r.nom.toLowerCase().includes(filter); });
    list.innerHTML = '';

    /* Toujours afficher "Autre / Je ne sais pas" en haut quand pas de filtre,
       ou si le filtre correspond à "autre" / "ne sais pas". */
    const otherMatches = !filter || 'autre'.includes(filter) || 'je ne sais pas'.includes(filter) || filter.includes('autre');
    if (otherMatches) {
      const liOther = document.createElement('li');
      liOther.className = 'calc-combo-item calc-combo-other';
      liOther.setAttribute('role', 'option');
      liOther.dataset.slug = 'autre';
      liOther.innerHTML = '<span class="combo-item-name">Autre / Je ne sais pas</span><span class="combo-item-meta">Préciser la taille manuellement</span>';
      liOther.addEventListener('mousedown', function(e) { e.preventDefault(); selectOther(); });
      list.appendChild(liOther);
    }

    if (matches.length === 0 && !otherMatches) {
      list.innerHTML = '<li class="calc-combo-empty" role="presentation">Aucune race ne correspond.</li>';
      list.hidden = false; return;
    }
    if (matches.length === 0) {
      /* "Autre" est seul affiché, OK */
      list.hidden = false; return;
    }
    /* RACES déjà triées côté Astro : taille → alphabétique. Séparateur quand la taille change. */
    let currentTaille = null;
    let idx = 0;
    matches.forEach(function(r) {
      if (r.taille !== currentTaille) {
        currentTaille = r.taille;
        const hdr = document.createElement('li');
        hdr.className = 'calc-combo-section';
        hdr.setAttribute('role', 'presentation');
        const label = r.taille === 'petite' ? 'Petites races' : (r.taille === 'moyenne' ? 'Races moyennes' : 'Grandes races');
        hdr.textContent = label;
        list.appendChild(hdr);
      }
      const li = document.createElement('li');
      li.className = 'calc-combo-item';
      li.setAttribute('role', 'option');
      li.dataset.slug = r.slug;
      li.dataset.idx = String(idx++);
      li.innerHTML = '<span class="combo-item-name">' + r.nom + '</span><span class="combo-item-meta">risque ' + r.risque + '</span>';
      li.addEventListener('mousedown', function(e) { e.preventDefault(); selectRace(r); });
      list.appendChild(li);
    });
    list.hidden = false;
    activeIdx = -1;
  }

  function selectRace(r) {
    input.value = r.nom;
    hidden.value = r.slug;
    clear.hidden = false;
    list.hidden = true;
    input.setAttribute('aria-expanded', 'false');
    const mapped = TAILLE_FROM_RACE[r.taille];
    if (mapped) {
      const radio = document.querySelector('input[name="taille"][value="' + mapped + '"]');
      if (radio && !radio.checked) {
        radio.checked = true;
        syncActiveClasses();
      }
    }
    /* Race connue → on masque la question taille (auto-fill silencieux) */
    hideTailleFieldset();
    resetIncidentToDefault(r);
    scheduleCompute();
  }

  function selectOther() {
    input.value = 'Autre / Je ne sais pas';
    hidden.value = 'autre';
    clear.hidden = false;
    list.hidden = true;
    input.setAttribute('aria-expanded', 'false');
    /* "Autre" → on affiche la question taille pour que l'utilisateur la renseigne */
    showTailleFieldset();
    resetIncidentToDefault(null);
    scheduleCompute();
  }

  input.addEventListener('focus', function() {
    renderList(input.value);
    input.setAttribute('aria-expanded', 'true');
  });
  input.addEventListener('input', function() {
    renderList(input.value);
    input.setAttribute('aria-expanded', 'true');
    if (input.value === '') { hidden.value = ''; clear.hidden = true; scheduleCompute(); }
  });
  input.addEventListener('keydown', function(e) {
    const items = list.querySelectorAll('.calc-combo-item');
    if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(items.length - 1, activeIdx + 1); items.forEach(function(it, i) { it.classList.toggle('is-active', i === activeIdx); }); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(0, activeIdx - 1); items.forEach(function(it, i) { it.classList.toggle('is-active', i === activeIdx); }); }
    else if (e.key === 'Enter') { e.preventDefault(); if (activeIdx >= 0 && items[activeIdx]) { const slug = items[activeIdx].dataset.slug; if (slug === 'autre') { selectOther(); } else { const r = RACES.find(function(rc) { return rc.slug === slug; }); if (r) selectRace(r); } } }
    else if (e.key === 'Escape') { list.hidden = true; input.setAttribute('aria-expanded', 'false'); }
  });
  clear.addEventListener('click', function() {
    input.value = ''; hidden.value = ''; clear.hidden = true;
    /* Effacer la race → la taille doit redevenir visible et obligatoire */
    showTailleFieldset();
    resetIncidentToDefault(null);
    input.focus(); renderList(''); scheduleCompute();
  });
  document.addEventListener('click', function(e) {
    if (!combo.contains(e.target)) { list.hidden = true; input.setAttribute('aria-expanded', 'false'); }
  });
}

/* ───── Tooltips infobulle (point 2 retours) — click/tap pour ouvrir, click ailleurs pour fermer ───── */
function initTooltips() {
  const infos = document.querySelectorAll('.br-info');
  infos.forEach(function(el) {
    el.setAttribute('tabindex', '0');
    el.setAttribute('role', 'button');
    el.addEventListener('click', function(e) {
      e.stopPropagation();
      const wasOpen = el.classList.contains('is-open');
      document.querySelectorAll('.br-info.is-open').forEach(function(o) { o.classList.remove('is-open'); });
      if (!wasOpen) el.classList.add('is-open');
    });
    el.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        el.click();
      }
      if (e.key === 'Escape') el.classList.remove('is-open');
    });
  });
  document.addEventListener('click', function() {
    document.querySelectorAll('.br-info.is-open').forEach(function(o) { o.classList.remove('is-open'); });
  });
}

document.addEventListener('DOMContentLoaded', function() {
  initRaceCombo();
  initTooltips();
  initScenarioCards();
  initIncidentAdjuster();
  document.querySelectorAll('.calc-form input, .calc-form select').forEach(function(el) {
    el.addEventListener('change', function() {
      syncActiveClasses();
      scheduleCompute();
    });
  });
  syncActiveClasses();
  renderEmpty();
  updateProgress();
});

</script>
